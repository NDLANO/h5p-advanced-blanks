{
  "compilerOptions": {
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "rootDir": "./src",
    "outDir": "./dist/",
    "sourceMap": true,
    "strict": false,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2024",
    "noEmit": false,
    "types": ["jquery"],
    // "noUnusedLocals": true,
    // "noUnusedParameters": true,
    "noImplicitReturns": true,
    "paths": {
      "@content-loaders/*": ["./src/scripts/content-loaders/*"],
      "@controllers/*": ["./src/scripts/controllers/*"],
      "@helpers/*": ["./src/scripts/helpers/*"],
      "@models/*": ["./src/scripts/models/*"],
      "@root/*": ["./src/*"],
      "@scripts/*": ["./src/scripts/*"],
      "@services/*": ["./src/scripts/services/*"],
      "@styles/*": ["./src/styles/*"],
      "@views/*": ["./src/scripts/views/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "*.d.ts"]
}
