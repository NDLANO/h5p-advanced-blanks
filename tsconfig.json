{
  "compilerOptions": {
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "rootDir": "./src",
    "outDir": "./dist/",
    "sourceMap": true,
    "strict": false,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2024",
    "noEmit": false,
    // "noUnusedLocals": true,
    // "noUnusedParameters": true,
    "noImplicitReturns": true,
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "*.d.ts"]
}
